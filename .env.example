# 复制为 .env 并填写;.env 不入 git

# ---- 启用的邮箱账号(逗号分隔的小写名,对应下方 MAIL_<名>_*) ----
MAIL_ACCOUNTS=smail,163,qq

# ---- smail 学校邮箱(腾讯企业邮托管,端点用 exmail.qq.com;开启"安全登录"后
#      IMAP/SMTP 只认"客户端专用密码",网页登录密码会报 Login fail)----
MAIL_SMAIL_USER=
MAIL_SMAIL_PASS=
MAIL_SMAIL_IMAP=imap.exmail.qq.com
MAIL_SMAIL_SMTP=smtp.exmail.qq.com

# ---- 163 邮箱(密码用"客户端授权码":163 网页设置→POP3/SMTP/IMAP 开启并生成)----
MAIL_163_USER=
MAIL_163_PASS=
MAIL_163_IMAP=imap.163.com
MAIL_163_SMTP=smtp.163.com

# ---- QQ 邮箱(密码用"授权码":QQ 邮箱设置→账户→生成授权码)----
MAIL_QQ_USER=
MAIL_QQ_PASS=
MAIL_QQ_IMAP=imap.qq.com
MAIL_QQ_SMTP=smtp.qq.com

# ---- Bark 推送 (iOS) ----
BARK_KEY=
# ---- ehall 统一身份认证 ----
EHALL_USER=
EHALL_PASS=
# ---- 本地服务端口 ----
SERVER_PORT=8765
